# Neon PostgreSQL connection string (Neon dashboard > Connection Details)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-secure-random-secret
PORT=5000

# Resend Email Service for Customer & Admin OTP Authentication
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Anmol VideoGraphy <onboarding@resend.dev>"
OTP_EXPIRES_MINUTES=5

# Optional Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
